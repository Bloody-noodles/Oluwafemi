---
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
}
const { title, description = "Oluwafemi Waya — Website Developer. I design and build fast, responsive websites and web apps." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#FFF8F1" />
    <link rel="icon" href="data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 100 100'><circle cx='50' cy='50' r='45' fill='%23FF5A1F'/><text x='50' y='68' font-size='55' text-anchor='middle' fill='white' font-family='sans-serif' font-weight='bold'>O</text></svg>" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600&family=Space+Grotesk:wght@400;500;600;700&display=swap" rel="stylesheet" />
    <title>{title}</title>
  </head>
  <body>
    <slot />
    <script>
      // Scroll reveal
      const io = new IntersectionObserver(
        (entries) => {
          entries.forEach((e) => {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          });
        },
        { threshold: 0.12 }
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Hero photo rotation
      const photos = document.querySelectorAll('.photo-stack img');
      if (photos.length > 1) {
        let i = 0;
        setInterval(() => {
          photos[i].classList.remove('active');
          i = (i + 1) % photos.length;
          photos[i].classList.add('active');
        }, 2600);
      }

      // Mobile menu
      const btn = document.getElementById('menu-btn');
      const menu = document.getElementById('mobile-menu');
      if (btn instanceof HTMLButtonElement && menu instanceof HTMLElement) {
        const menuLinks = menu.querySelectorAll<HTMLAnchorElement>('[data-menu-link]');
        const closeMenu = (returnFocus = false) => {
          menu.classList.add('hidden');
          btn.setAttribute('aria-expanded', 'false');
          btn.setAttribute('aria-label', 'Open menu');
          if (returnFocus) btn.focus();
        };

        btn.addEventListener('click', () => {
          const isOpening = menu.classList.contains('hidden');
          menu.classList.toggle('hidden', !isOpening);
          btn.setAttribute('aria-expanded', String(isOpening));
          btn.setAttribute('aria-label', isOpening ? 'Close menu' : 'Open menu');
          if (isOpening) menuLinks[0]?.focus();
        });

        menuLinks.forEach((link) => link.addEventListener('click', () => closeMenu()));
        document.addEventListener('keydown', (event) => {
          if (event.key === 'Escape' && !menu.classList.contains('hidden')) closeMenu(true);
        });
        window.matchMedia('(min-width: 768px)').addEventListener('change', (event) => {
          if (event.matches) closeMenu();
        });
      }
    </script>
  </body>
</html>
