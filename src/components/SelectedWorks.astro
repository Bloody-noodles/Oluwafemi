---
import abeautosImage from "../images/abeautos.png";
import aveionImage from "../images/aveion.png";
import braintrackImage from "../images/braintrack.png";
import dpodiumImage from "../images/d'podium.png";
import havardImage from "../images/havard.png";
import naijaFlavoursImage from "../images/naija flavor.png";
import nikkihairtsylesImage from "../images/nikkihairtsyles.png";
import tramplerImage from "../images/trampler.png";

const featured = [
  {
    title: "Amala Spot",
    tags: "Next.js, TypeScript, Tailwind CSS, Supabase, Gemini",
    desc: "A premium Nigerian food discovery and ordering concept, bringing Yoruba food culture into a polished digital experience with editorial storytelling, menu exploration, and a demonstration ordering flow.",
    highlights: ["Responsive Nigerian food website and editorial landing page", "Food categories, menu discovery, and demo basket experience", "Gemini-powered conversational ordering assistant in the product vision"],
    img: "https://image.thum.io/get/width/1200/crop/900/https://amala-spot-site.vercel.app/",
    link: "https://amala-spot-site.vercel.app/",
    repo: "https://github.com/Bloody-noodles/amala-spot",
    year: "2026",
  },
  {
    title: "Dee-Faith Pride Multi-Biz",
    tags: "Astro, TypeScript, Tailwind CSS, Supabase",
    desc: "A mobile-friendly digital-services storefront for a Nigerian business, bringing everyday requests into one place with service discovery, provider references, and WhatsApp-led enquiries.",
    highlights: ["Service catalogue and category shortcuts", "WhatsApp-first service enquiries", "Manual payment review and fulfilment workflow"],
    img: "https://image.thum.io/get/width/1200/crop/800/https://dee-faith-pride.vercel.app/",
    link: "https://dee-faith-pride.vercel.app/",
    year: "2026",
  },
  {
    title: "Nikihairstyles",
    tags: "Web Design, Tailwind CSS",
    desc: "A luxury hair-stylist brand site with signature services, a transformation gallery, and a WhatsApp-first booking flow — built to turn visitors into appointments.",
    highlights: ["Service presentation", "Transformation gallery", "WhatsApp-first booking flow"],
    img: nikkihairtsylesImage,
    link: "https://nikkihair.netlify.app/",
    year: "2025",
  },
  {
    title: "AbeAutos",
    tags: "React, TypeScript, Tailwind",
    desc: "A premium car-dealership experience for the Lagos market — featured inventory, import services, and a showroom gallery designed for serious buyers.",
    highlights: ["Featured vehicle inventory", "Import services", "Showroom gallery"],
    img: abeautosImage,
    link: "https://abegautos.lovable.app/",
    year: "2025",
  },
  {
    title: "D'Podium Events",
    tags: "HTML, CSS3, JavaScript",
    desc: "An event-centre showcase for weddings, conferences and live events — venue hire, planning services and a structured enquiry flow in one clean experience.",
    highlights: ["Venue hire information", "Event-planning services", "Structured enquiry flow"],
    img: dpodiumImage,
    link: "https://dpodium.netlify.app/",
    year: "2025",
  },
  {
    title: "Aveion Airline",
    tags: "JavaScript, UI Design",
    desc: "A live airport-experience concept with real-time flight boards, a destination explorer and terminal updates — an interface built around motion and data.",
    highlights: ["Real-time flight boards", "Destination explorer", "Terminal updates"],
    img: aveionImage,
    link: "https://aveion-airline.netlify.app/",
    year: "2025",
  },
];

const more = [
  { title: "Trampler", meta: "E-commerce concept — Men's sneakers", link: "https://trampler.netlify.app/", img: tramplerImage },
  { title: "Naija Flavours", meta: "Recipes & stories — Nigerian cuisine", link: "https://naija-flavours.netlify.app/", img: naijaFlavoursImage },
  { title: "Havard Restaurant", meta: "Restaurant & lounge — Uyo", link: "https://havardresturant.netlify.app/", img: havardImage },
  { title: "Braintrack", meta: "Design & construction showcase", link: "https://braintrack-architect-showcase.lovable.app/", img: braintrackImage },
];
---
<section id="works" class="px-4 sm:px-6 py-20">
  <div class="mx-auto max-w-6xl">
    <div class="reveal max-w-2xl">
      <h2 class="font-display font-bold text-4xl sm:text-5xl tracking-tight">My selected works</h2>
      <p class="mt-5 text-lg text-ink/70 leading-relaxed">
        With my keen eye for detail and clean, maintainable code, I specialize in crafting
        captivating <strong>websites</strong>, <strong>products</strong>, and <strong>experiences</strong>.
      </p>
    </div>

    <div class="mt-14 flex flex-col gap-20">
      {featured.map((p, i) => (
        <article class:list={["work-card reveal group grid md:grid-cols-2 gap-8 items-center", i % 2 === 1 && "md:[&>*:first-child]:order-2"]}>
          <a href={p.link} target="_blank" rel="noopener" aria-label={`View ${p.title} live site`} class="overflow-hidden rounded-3xl border border-ink/10 shadow-sm">
            <img src={typeof p.img === "string" ? p.img : p.img.src} alt={p.title + " project screenshot"} class="w-full h-auto" loading="lazy" />
          </a>
          <div>
            <span class="font-display text-sm font-semibold text-ink/40">{String(i + 1).padStart(2, "0")} — {p.year}</span>
            <h3 class="font-display font-bold text-3xl sm:text-4xl mt-3 group-hover:text-tang transition-colors">{p.title}</h3>
            <p class="mt-2 text-sm font-semibold text-tang">{p.tags}</p>
            <p class="mt-4 text-ink/65 leading-relaxed">{p.desc}</p>
            <details class="mt-5 rounded-2xl border border-ink/10 bg-white/70 p-4">
              <summary class="cursor-pointer font-semibold text-sm marker:text-tang focus-visible:outline-2 focus-visible:outline-offset-4 focus-visible:outline-tang">
                Project highlights
              </summary>
              <ul class="mt-3 space-y-2 text-sm text-ink/65">
                {p.highlights.map((highlight) => <li class="flex gap-2"><span class="text-tang" aria-hidden="true">✳</span>{highlight}</li>)}
              </ul>
            </details>
            <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-3">
              <a href={p.link} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold border-b-2 border-tang pb-1">
                View live site
                <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" class="group-hover:translate-x-1 group-hover:-translate-y-1 transition-transform" aria-hidden="true"><path d="M7 17L17 7M7 7h10v10"/></svg>
              </a>
              {p.repo && <a href={p.repo} target="_blank" rel="noopener" class="inline-flex items-center gap-2 text-sm font-semibold text-ink/65 hover:text-tang transition-colors">View source code ↗</a>}
            </div>
          </div>
        </article>
      ))}
    </div>

    <div class="reveal mt-24">
      <h3 class="font-display font-bold text-2xl">More builds</h3>
      <div class="mt-8 grid sm:grid-cols-2 lg:grid-cols-4 gap-5">
        {more.map((m) => (
          <a href={m.link} target="_blank" rel="noopener" class="group rounded-3xl bg-white border border-ink/10 overflow-hidden hover:-translate-y-1.5 hover:shadow-lg transition-all duration-300">
            <div class="overflow-hidden">
              <img src={m.img.src} alt={m.title + " project screenshot"} class="w-full h-auto" loading="lazy" />
            </div>
            <div class="p-5">
              <h4 class="font-display font-bold group-hover:text-tang transition-colors">{m.title}</h4>
              <p class="text-sm text-ink/55 mt-1">{m.meta}</p>
            </div>
          </a>
        ))}
      </div>
    </div>
  </div>
</section>
